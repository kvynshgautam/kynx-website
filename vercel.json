{
  "version": 2,
  "rewrites": [
    {
      "source": "/download/apk",
      "destination": "/api/index.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/(.*)",
      "destination": "/$1"
    }
  ]
}
