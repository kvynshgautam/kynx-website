{
  "version": 2,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/download/apk",
      "destination": "https://github.com/kvynshgautam/kynx-website/releases/latest/download/KYNX-latest.apk",
      "permanent": false
    },
    {
      "source": "/download/ipa",
      "destination": "https://github.com/kvynshgautam/kynx-website/releases/download/v0.9.64/KYNX-v0.9.64.ipa",
      "permanent": false
    },
    {
      "source": "/downloads/:path*",
      "destination": "https://github.com/kvynshgautam/kynx-website/releases/latest/download/KYNX-latest.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/web", "destination": "/web.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
